# ===================================================
# StudySphere AI - Backend Environment Variables
# ===================================================

# Server Configuration
PORT=5000
FLASK_ENV=production
SECRET_KEY=generate_a_random_secure_hex_key_here

# JWT Authentication
JWT_SECRET=generate_a_random_jwt_secret_here
JWT_REFRESH_SECRET=generate_a_random_refresh_secret_here

# Database Configuration
# Remote MongoDB Atlas connection string (preferred for production):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studysphere?retryWrites=true&w=majority
# If MONGODB_URI is left empty, the application falls back to SQLite WAL mode storage.
# Optional persistent directory for SQLite (e.g. on Render persistent disk or Railway volume):
# PERSISTENT_DATA_DIR=/data

# AI Integrations
# Google Gemini API Key (Required for AI Tutor, Quiz, Summarization, and OCR)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# CORS & Allowed Origins (Comma-separated URLs)
FRONTEND_URL=https://studysphere-ai-phi.vercel.app
CORS_ORIGINS=https://studysphere-ai-phi.vercel.app,http://localhost:5173,http://localhost:3000

# Admin Bootstrap Credentials (Used by backend/scripts/seed_admin.py)
ADMIN_EMAIL=admin@studysphere.ai
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=StudySphere Administrator
ADMIN_ROLE=admin
