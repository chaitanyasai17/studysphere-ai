# ===================================================
# StudySphere AI - Frontend Environment Variables
# ===================================================

# Backend API Base URL
# In local development: leave empty (Vite proxy forwards /api to http://127.0.0.1:5000) or set to http://127.0.0.1:5000
# In production on Vercel: set to your deployed backend domain (or leave blank if using Vercel rewrites in vercel.json)
# Example:
VITE_API_URL=https://studysphere-ai-zf1a.onrender.com
