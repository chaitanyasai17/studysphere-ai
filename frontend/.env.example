# ===================================================
# StudySphere AI - Frontend Environment Variables
# ===================================================

# Backend API Base URL
# In local development: leave empty (defaults to http://localhost:5000) or set explicitly.
# In production on Vercel: set to your deployed backend domain (e.g. https://your-backend.onrender.com)
# or leave empty to use same-origin relative URLs (/api) proxied by Vercel rewrites.
# NOTE: Vite variables are embedded AT BUILD TIME. A new deployment is required after changing this in Vercel.
VITE_API_URL=
